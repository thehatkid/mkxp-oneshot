#include <winver.h>
#include <winuser.h>

#include "resource.h"

#define MKXP_VERSION @VERSION_MAJOR@, @VERSION_MINOR@, @VERSION_PATCH@, 0

#ifdef DEBUG
#define MKXP_FILEFLAGS VS_FF_DEBUG
#else
#define MKXP_FILEFLAGS 0x0
#endif

LANGUAGE 0x0, 0x0

// Resource Files
IDI_ICON ICON "@ICON_FILE@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@MANIFEST_FILE@"

// Version Info
VS_VERSION_INFO VERSIONINFO
FILEVERSION MKXP_VERSION
PRODUCTVERSION MKXP_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS MKXP_FILEFLAGS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
{
	BLOCK "StringFileInfo"
	{
		BLOCK "000004B0"
		{
			VALUE "FileDescription",  "@FILE_DESC@"
			VALUE "FileVersion",      "@PROJECT_VERSION@"
			VALUE "ProductName",      "@PRODUCT_NAME@"
			VALUE "ProductVersion",   "@PROJECT_VERSION@"
			VALUE "InternalName",     "@PROJECT_NAME@"
			VALUE "OriginalFilename", "@FILENAME@"
			VALUE "CompanyName",      "@AUTHOR@"
			VALUE "LegalCopyright",   "@COPYRIGHT@"
			VALUE "Comment",          "@COMMENT@"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0, 1200
	}
}
